0.39, null, null, null, null, "COSMOTE DP24L (RB1)_24 μήνες (Offer 1)", null, null, null, null, null, "έως 24 Mbps", null, "Απεριόριστα", null, 120, null, 27.9, null], [null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, "COSMOTE DP24 XL (RB1)_24μήνες (Offer 1)", null, null, null, null, null, "έως 24 Mbps", null, "Απεριόριστα", null, 420, null, 29.9, null], [null, null, "Για νέα Τηλεφωνική Γραμμή ΟΤΕ, χρεώνεται εφάπαξ τέλος ενεργοποίησης € 36,38. ", null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, "COSMOTE DP50L (RB1)_24 μήνες (Offer 2)", null, null, null, null, null, "έως 50Mbps", null, "Απεριόριστα", null, 120, null, 32.9, null], [null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, "DP50 XL (RB1) - 24 μήνες (Offer)", null, null, null, null, null, "έως 50Mbps", null, "Απεριόριστα", null, 420, null, 36.9, null], [null, null, "Ο ρυθμός κάλυψης του συμπεριλαμβανομένου χρόνου ομιλίας είναι με βήμα χρέωσης το λεπτό.Μετά την εξάντληση του συμπεριλαμβανομένου χρόνου, οι χρεώσεις διαμορφώνονται ως εξής (με βήμα χρέωσης ανά λεπτό): οι κλήσεις προς εθνικά σταθερά χρεώνονται με € 0,25/λεπτό και προς εθνικά κινητά χρεώνονται με € 0,50/λεπτό.", null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, "COSMOTE 50 UNL (RB)_24 μήνες (Offer 1)", null, null, null, null, null, "έως 50Mbps", null, "Απεριόριστα", null, "Απεριόριστα", null, 32.9, null], [null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, "ΣΗΜΕΙΑ ΠΡΟΣΟΧΗΣ FTTH", null, null, null, null, null, null, null, null, null, null, null, null, null], [null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, 1, "Ο πωλητής καταχωρεί τη Διεύθυνση Εγκατάστασης. ΣΗΜΑΝΤΙΚΟ : ρωτά τον πελάτη και εισάγει με προσοχή στο σύστημα τον ΟΡΟΦΟ στον οποίο βρίσκεται και το ΔΙΑΜΕΡΙΣΜΑ του.", null, null, null, null, null, null, null, null, null, null, null, null], [null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, 2, "Καταχωρεί το Ονοματεπώνυμο και το Κινητό τηλέφωνο του Διαχειριστή. Σε περίπτωση που ο πελάτης δεν γνωρίζει το κινητό τηλέφωνο του Διαχειριστή, ο πωλητής καταχωρεί το κινητό τηλέφωνο επικοινωνίας του πελάτη αλλά ενημερώνει τον πελάτη ότι θα πρέπει βρει τα στοιχεία του Διαχειριστή και να τα δώσει στον Μηχανικό που θα τον καλέσει αλλιώς το αίτημα θα ακυρωθεί . (Σημείωση: τα στοιχεία διαχειριστή δεν χρειάζονται για διασυνδεδεμένο κτίριο σε Υποδομές FTTH ΟΤΕ)", null, null, null, null, null, null, null, null, null, null, null, null], [null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, 3, "Σε ένα κτίριο μπορεί να απαγορευθεί η υλοποίηση FTTH μόνο εφόσον υπάρχει ομόφωνη άρνηση από τη Γενική Συνέλευση ιδιοκτητών.", null, null, null, null, null, null, null, null, null, null, null, null], [null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, 4, "Το ραντεβού από τον Μηχανικό ΟΤΕ για την επιθεώρηση του Κτιρίου θα οριστεί μετά από τηλεφώνημα του στο Διαχειριστή ή στον Πελάτη. Το ραντεβού μπορεί να οριστεί από Δευτέρα έως Παρασκευή 08:00-16:00 και στο\nραντεβού αυτό θα πρέπει να παρευρίσκονται ο Διαχειριστής και ο Πελάτης. Στη λήξη του ραντεβού, ο Μηχανικός ΟΤΕ θα δώσει ένα έγγραφο στον Διαχειριστή με ένα σκαρίφημα της μελέτης του κτιρίου και ένα κείμενο στο οποίο ο Διαχειριστής θα πρέπει να επιλέξει και να υπογράψει υπό ποιές προϋποθέσεις θα προχωρήσει η\nυλοποίηση.", null, null, null, null, null, null, null, null, null, null, null, null], [null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, 5, "Στα Double Play με FTTH (Νέα Γραμμή ή Φορητότητα) δεν χρεώνονται τα αντίστοιχα τέλη αλλά ΜΟΝΟ τα Τέλη Ενεργοποίησης και Εγκατάστασης Οπτικής Ίνας ( FTTH). Το εφάπαξ τέλος ενεργοποίησης 50 €, παρέχεται δωρεάν ως προσφορά περιορισμένης διάρκειας ΜΟΝΟ στα προγράμματα ταχυτήτων 50Mbps, 100Mbps, 200Mbps, για νέες ενεργοποιήσεις FTTH.", null, null, null, null, null, null, null, null, null, null, null, null], [null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, 6, "Διαδικασία ενεργοποίησης σε κτίριο στο οποίο δεν υπάρχει άλλος πελάτης FTTH ~ 2 μήνες", null, null, null, null, null, null, null, null, null, null, null, null], [null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, 7, "Διαδικασία ενεργοποίησης κτίριο στο οποίο υπάρχει ήδη άλλος ενεργός πελάτης FTTH ~ 20 ημέρες", null, null, null, null, null, null, null, null, null, null, null, null]]